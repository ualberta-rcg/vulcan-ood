#!/usr/bin/env bash
# script.sh.erb — thin launcher. The chosen desktop file (gnome/mate/xfce/none) is
# ERB-inlined from var/www/ood/apps/templates/desktops/ at render time (like
# form_params), so it's baked into this staged script and works on the compute node
# (NOT a runtime reference — that's what failed for form.js).
echo "[script] starting desktop '<%= context.desktop %>' for $USER"
cd "${HOME}" || { echo "[script] ERROR: cd $HOME failed"; exit 1; }
export SHELL="${SHELL:-/bin/bash}"
xhost +SI:localuser:$USER 2>/dev/null || true
<% tpl = "/var/www/ood/apps/templates/desktops/" %>
<% IO.foreach(tpl + "#{context.desktop}.sh") do |line| %><%= line %><% end %>
