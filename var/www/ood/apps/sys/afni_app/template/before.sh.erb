#!/bin/bash
# before.sh.erb — runtime + GPU setup ONLY. All desktop logic (browser default,
# chrome patch, autostart, proxy, DE session, app launch) lives in the shared
# var/www/ood/apps/templates/desktops/<de>.sh, ERB-inlined by script.sh.erb.
echo "[before] user=$USER uid=$(id -u)"

[[ $(type -t module) == "function" ]] && export -f module

# runtime dirs (root): /tmp/.ICE-unix + /run/user/$UID
sudo /usr/local/bin/create-ice.sh "$(id -u)"
export OOD_DIR="${PWD}"

# app launch + thread count (form-driven; the desktop file reads them as env)
export OMP_NUM_THREADS="<%= context.num_cores %>"
<% if context.launch_app && !context.launch_app.strip.empty? %>
export OOD_APP_LAUNCH="<%= context.launch_app.strip %>"
echo "[before] app launch: <%= context.launch_app.strip %>"
<% end %>

# strip login-shell leftovers that confuse desktop sessions
unset DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID XDG_SESSION_TYPE WAYLAND_DISPLAY
unset $(env | grep -o '^BASH_FUNC_.*%%' | cut -d= -f1) 2>/dev/null || true
export XDG_RUNTIME_DIR="/tmp/xdg-runtime-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"
echo "[before] XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"

# GPU / VirtualGL — libvglfaker-nodl ONLY (libdlfaker hooks dlopen() and breaks app stacks)
VGL_FAKER="/usr/lib/libvglfaker-nodl.so"
GPU_PRESENT=$(nvidia-smi --query-gpu=name --format=csv,noheader,nounits 2>/dev/null | grep -v '^$' | head -n1)
if [[ -n "$GPU_PRESENT" && "$GPU_PRESENT" != "No devices were found" && -f "$VGL_FAKER" ]]; then
  export OOD_GPU_AVAILABLE=true VGL_DISPLAY=egl
  export LD_PRELOAD="$VGL_FAKER${LD_PRELOAD:+:${LD_PRELOAD}}"
  echo "[before] GPU=$GPU_PRESENT; VirtualGL enabled (libvglfaker-nodl + EGL)"
else
  export OOD_GPU_AVAILABLE=false LIBGL_ALWAYS_SOFTWARE=1 QT_QUICK_BACKEND=software
  echo "[before] no GPU/VirtualGL — software rendering"
fi

# AFNI atlas datasets — cached per-user under $SCRATCH/.afni so whereami has
# its default atlases. Fetched once from AFNI's public (public-domain) data
# server; skipped on subsequent launches if already extracted. The two version
# defaults the binary names (Julich_MNI2009c_v3.1 / Brodmann_Pijn_AFNI) are
# license-restricted and NOT in the free package, so those warnings persist by
# design — but all 103 redistributable atlases (TT_, MNI_, CAEZ, Glasser, ...)
# become available and whereami works.
export AFNI_ATLASDIR="${SCRATCH:-$HOME/scratch}/.afni/afni_atlases/atlases"
if [[ -d "$AFNI_ATLASDIR" && -n "$(ls -A "$AFNI_ATLASDIR" 2>/dev/null)" ]]; then
  echo "[before] AFNI atlases present: $AFNI_ATLASDIR"
else
  AFNI_HOME="$(dirname "$(dirname "$AFNI_ATLASDIR")")"   # $SCRATCH/.afni
  mkdir -p "$AFNI_HOME"
  echo "[before] AFNI atlases missing — fetching afni_atlases.tgz (~90 MB, one-time)"
  if curl -fsSL --connect-timeout 20 -o "$AFNI_HOME/afni_atlases.tgz.partial" \
        https://afni.nimh.nih.gov/pub/dist/data/afni_atlases.tgz; then
    mv "$AFNI_HOME/afni_atlases.tgz.partial" "$AFNI_HOME/afni_atlases.tgz"
    if tar -xzf "$AFNI_HOME/afni_atlases.tgz" -C "$AFNI_HOME"; then
      echo "[before] AFNI atlases extracted to $AFNI_HOME/afni_atlases"
    else
      echo "[before] WARNING: atlas extraction failed — whereami default atlases unavailable this session"
    fi
  else
    rm -f "$AFNI_HOME/afni_atlases.tgz.partial"
    echo "[before] WARNING: atlas download failed — whereami default atlases unavailable this session"
  fi
fi
echo "[before] setup complete"
