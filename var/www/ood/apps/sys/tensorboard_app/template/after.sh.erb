#!/bin/bash
# after.sh.erb — wait for the TensorBoard server (OOD batch_connect 'after' hook).
echo "[after] waiting for TensorBoard on ${host}:${port} (timeout 600s)..."
if wait_until_port_used "${host}:${port}" "600"; then
  echo "[after] TensorBoard is up on port ${port}"
else
  echo "[after] ERROR: timed out waiting for port ${port} — check output.log"
  clean_up 1
fi
sleep 2
echo "[after] ready"
