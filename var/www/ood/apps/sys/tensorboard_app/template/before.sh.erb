#!/bin/bash
# before.sh.erb — TensorBoard setup. Shared preamble from templates/web_setup.sh;
# log file + logdir resolution below.
export OOD_APP_NAME="tensorboard"
<% template_root = "/var/www/ood/apps/templates/" %>
<% IO.foreach(template_root + "web_setup.sh") do |line| %><%= line %><% end %>

# --- TensorBoard-specific ---
export TENSORBOARD_LOG_FILE="${JOB_DIR}/tensorboard.log"
LOGDIR_FROM_FORM="<%= context.respond_to?(:logdir) ? context.logdir.to_s.strip : "" %>"
if [[ -n "${LOGDIR_FROM_FORM}" ]]; then
  export TENSORBOARD_LOGDIR="${LOGDIR_FROM_FORM}"
elif [[ -z "${TENSORBOARD_LOGDIR}" ]]; then
  export TENSORBOARD_LOGDIR="${JOB_DIR}/runs"
fi
[[ -e "${TENSORBOARD_LOGDIR}" && ! -d "${TENSORBOARD_LOGDIR}" ]] && { echo "[before:${OOD_APP_NAME}] ERROR: not a directory: ${TENSORBOARD_LOGDIR}"; exit 1; }
mkdir -p "${TENSORBOARD_LOGDIR}" || { echo "[before:${OOD_APP_NAME}] ERROR: cannot create ${TENSORBOARD_LOGDIR}"; exit 1; }
echo "[before:${OOD_APP_NAME}] logdir=${TENSORBOARD_LOGDIR}"
