#!/bin/bash
# before.sh.erb — TensorBoard setup (OOD batch_connect 'before' hook).
echo "[before] starting TensorBoard setup for $USER (uid $(id -u))"

if [[ $(type -t module) == "function" ]]; then export -f module; else echo "[before] WARN: module function unavailable"; fi

export port="$(find_port ${host})"
[[ -z "$port" ]] && { echo "[before] ERROR: no free port"; exit 1; }
export JOB_DIR="${PWD}"
export CC_CLUSTER=vulcan
echo "[before] port=${port} job_dir=${JOB_DIR}"

# --- TensorBoard: log file + logdir (form > env > default) ---
export TENSORBOARD_LOG_FILE="${JOB_DIR}/tensorboard.log"
LOGDIR_FROM_FORM="<%= context.respond_to?(:logdir) ? context.logdir.to_s.strip : "" %>"
if [[ -n "${LOGDIR_FROM_FORM}" ]]; then
  export TENSORBOARD_LOGDIR="${LOGDIR_FROM_FORM}"
elif [[ -z "${TENSORBOARD_LOGDIR}" ]]; then
  export TENSORBOARD_LOGDIR="${JOB_DIR}/runs"
fi
[[ -e "${TENSORBOARD_LOGDIR}" && ! -d "${TENSORBOARD_LOGDIR}" ]] && { echo "[before] ERROR: not a directory: ${TENSORBOARD_LOGDIR}"; exit 1; }
mkdir -p "${TENSORBOARD_LOGDIR}" || { echo "[before] ERROR: cannot create ${TENSORBOARD_LOGDIR}"; exit 1; }
echo "[before] logdir=${TENSORBOARD_LOGDIR}"
echo "[before] setup complete"
