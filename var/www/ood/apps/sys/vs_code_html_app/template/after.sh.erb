#!/bin/bash
# after.sh.erb — wait for the VS Code Server server (OOD batch_connect 'after' hook).
echo "[after] waiting for VS Code Server on ${host}:${port} (timeout 120s)..."
if wait_until_port_used "${host}:${port}" "120"; then
  echo "[after] VS Code Server is up on port ${port}"
else
  echo "[after] ERROR: timed out waiting for port ${port} — check output.log"
  clean_up 1
fi
sleep 2
echo "[after] ready"
