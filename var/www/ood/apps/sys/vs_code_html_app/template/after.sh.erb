#!/bin/bash
# after.sh.erb — wait for the code-server server. Shared wait logic lives in
# templates/web_after.sh (ERB-inlined here). Sets app name + timeout, nothing else.
export OOD_APP_NAME="code-server"
export WAIT_TIMEOUT=120
<% template_root = "/var/www/ood/apps/templates/" %>
<% IO.foreach(template_root + "web_after.sh") do |line| %><%= line %><% end %>
