#!/bin/bash
# before.sh.erb — VS Code Server setup. Shared preamble from templates/web_setup.sh;
# code-server data dir + password below.
export OOD_APP_NAME="vscode"
<% template_root = "/var/www/ood/apps/templates/" %>
<% IO.foreach(template_root + "web_setup.sh") do |line| %><%= line %><% end %>

# --- VS Code-specific ---
export CODESERVER_LOG_FILE="${JOB_DIR}/code-server.log"
export CODESERVER_DATA_HOME="${HOME}/.vscode-ood"
export CODESERVER_PASSWORD="$(create_passwd 16)"
export password="$CODESERVER_PASSWORD"
mkdir -p "$CODESERVER_DATA_HOME" || { echo "[before:${OOD_APP_NAME}] ERROR: mkdir $CODESERVER_DATA_HOME failed"; exit 1; }
echo "[before:${OOD_APP_NAME}] code-server data: ${CODESERVER_DATA_HOME}"
