#!/bin/bash
# before.sh.erb — OpenRefine setup. Shared preamble from templates/web_setup.sh;
# password + working dir below.
export OOD_APP_NAME="openrefine"
<% template_root = "/var/www/ood/apps/templates/" %>
<% IO.foreach(template_root + "web_setup.sh") do |line| %><%= line %><% end %>

# --- OpenRefine-specific ---
export password="$(create_passwd 16)"
export OPENREFINE_WORKDIR="${PWD}/openrefine-data"
export OPENREFINE_LOG_FILE="${PWD}/openrefine.log"
mkdir -p "$OPENREFINE_WORKDIR" || { echo "[before:${OOD_APP_NAME}] ERROR: mkdir $OPENREFINE_WORKDIR failed"; exit 1; }
echo "[before:${OOD_APP_NAME}] workdir=${OPENREFINE_WORKDIR} (module: openrefine/3.9.3)"
