#!/bin/bash
# before.sh.erb — OpenRefine setup (OOD batch_connect 'before' hook).
echo "[before] starting OpenRefine setup for $USER (uid $(id -u))"

if [[ $(type -t module) == "function" ]]; then export -f module; else echo "[before] WARN: module function unavailable"; fi

export port="$(find_port ${host})"
[[ -z "$port" ]] && { echo "[before] ERROR: no free port"; exit 1; }
export JOB_DIR="${PWD}"
export CC_CLUSTER=vulcan
echo "[before] port=${port} job_dir=${JOB_DIR}"

# --- OpenRefine: password + working dir (binary comes from the CVMFS module) ---
export password="$(create_passwd 16)"
export OPENREFINE_WORKDIR="${PWD}/openrefine-data"
export OPENREFINE_LOG_FILE="${PWD}/openrefine.log"
mkdir -p "$OPENREFINE_WORKDIR" || { echo "[before] ERROR: mkdir $OPENREFINE_WORKDIR failed"; exit 1; }
echo "[before] workdir=${OPENREFINE_WORKDIR} (module: openrefine/3.9.3)"
echo "[before] setup complete"
